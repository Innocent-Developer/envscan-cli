{
  "name": "envscan-cli",
  "version": "2.0.5",
  "description": "Audit your .env variables against your codebase. Catch missing, undocumented and unused vars — with auto-fix, watch mode, JSON/CI output, secret-leak detection, format validation, env comparison, a health score, an interactive setup wizard, HTML reports, and a pre-commit hook.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "envscan-cli": "./bin/envscan-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Innocent-Developer/envscan-cli.git"
  },
  "homepage": "https://envscan-cli.abubakkar.dev/",
  "bugs": {
    "url": "https://github.com/Innocent-Developer/envscan-cli/issues"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test:demo": "node bin/envscan-cli.js --dir ./test-project",
    "test:fix": "node bin/envscan-cli.js --dir ./test-project --fix",
    "test:json": "node bin/envscan-cli.js --dir ./test-project --json",
    "test:watch": "node bin/envscan-cli.js --dir ./test-project --watch",
    "test:stats": "node bin/envscan-cli.js --dir ./test-project --stats",
    "test:report": "node bin/envscan-cli.js --dir ./test-project --report html"
  },
  "keywords": [
    "env",
    "dotenv",
    "cli",
    "developer-tools",
    "environment-variables",
    "audit",
    "nodejs",
    "security",
    "ci",
    "secrets"
  ],
  "author": "Abubakkar Sajid",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@inquirer/prompts": "^8.7.2",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "glob": "^10.3.0",
    "ora": "^8.0.1"
  }
}
