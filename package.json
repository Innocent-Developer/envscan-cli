{
  "name": "env-doctor",
  "version": "1.0.0",
  "description": "Audit your .env variables against your codebase. Catch missing, undocumented and unused vars before they break production.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "env-doctor": "./bin/env-doctor.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test:demo": "node bin/env-doctor.js --dir ./test-project"
  },
  "keywords": [
    "env",
    "dotenv",
    "cli",
    "developer-tools",
    "environment-variables",
    "audit",
    "nodejs"
  ],
  "author": "Abubakkar Sajid",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "glob": "^10.3.0",
    "ora": "^8.0.1"
  }
}
